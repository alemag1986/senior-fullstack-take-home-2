DATABASE_PATH=journal.db
DEFAULT_USER_ID=dev-user-default
TAXONOMY_VERSION=1.0.0
MAX_ENTRY_CONTENT_LENGTH=10000

# ==============================================================================
# AI Provider Configuration
# Supported options: "openrouter" | "gemini" | "heuristic"
# To swap implementations, change AI_PROVIDER to your desired engine.
# If an API key is not supplied, the app automatically falls back to "heuristic"
# ==============================================================================
AI_PROVIDER=openrouter

# --- OpenRouter Settings ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=AI-Assisted Language Journaling
OPENROUTER_TIMEOUT_SECONDS=20.0

# --- Google Gemini Settings (Alternative) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
